# VanillaForms - Variables de entorno
# Copiar a .env y ajustar valores
# Cargado por app/Core/Env.php (implementacion propia, sin Composer)

# Aplicacion
APP_NAME=VanillaForms
APP_URL=http://127.0.0.1:8080
# URL PÚBLICA para el enlace que se copia, el código QR y el embed. Déjala
# VACÍA y se deduce del host por el que se está sirviendo la app (lo normal en
# una instalación self-hosted). Fíjala solo si hay un proxy, varios dominios o
# algo que el Host de la petición no refleje, p. ej. https://formularios.midominio.com
# Antes estos tres usos salían siempre de APP_URL, así que al servir la app en
# otro host el QR y el enlace copiado apuntaban a 127.0.0.1 y no abrían nada.
APP_PUBLIC_URL=
APP_ENV=development
# Solo true si hay un proxy de confianza (nginx/haproxy) que sobrescribe X-Forwarded-For/X-Real-IP
TRUST_PROXY=false
# Límite de cuerpo JSON en bytes (endpoints tipo builder/save). Default: 2 MiB
MAX_JSON_BYTES=2097152
# Content-Security-Policy activa por defecto (vacio = desactivada).
# Requiere que los scripts estén externalizados (app.js, builder.js, analytics.js
# leen la config de servidor vía data-*). Estilo inline permitido (Bootstrap).
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
# X-Frame-Options: DENY (default) | SAMEORIGIN | dejar vacio para embeber formularios en iframes
FRAME_OPTIONS=DENY
# Webhooks a la red local: hace falta ESTE opt-in del servidor Y el del formulario
# (webhook.allow_private_hosts en sus settings). Con false (default) ningun webhook
# alcanza loopback/RFC1918/link-local aunque el dueno del formulario lo pida: es el
# corte de la frontera de autorizacion del SSRF (item 2.2). Ponlo a true solo si
# necesitas de verdad que la app POSTee a un servicio de tu LAN.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Allowlist de dominios para settings.thanks.redirect_url (post-submit, F5.1).
# Lista separada por comas de HOSTS (sin esquema ni ruta): https://tuformulario.com.
# Vacía por defecto = NINGUNA URL externa se sigue tras el envío: el thanks
# interno se muestra con un aviso y la respuesta igual se guarda. Es un opt-in
# SERVIDOR (como WEBHOOK_ALLOW_PRIVATE_HOSTS): quien edita un formulario solo
# puede declarar una URL, nunca ampliar esta lista; sin esto, un formulario
# servía de trampolín de phishing hacia CUALQUIER dominio.
APP_REDIRECT_ALLOWLIST=

# Cloudflare Turnstile (B2): verificacion anti-bot opt-IN POR FORMULARIO
# (settings.anti_bot.enabled, toggle en el builder). Sin estas dos claves, un
# formulario que lo pide se muestra como "temporalmente no disponible": nunca se
# sirve un formulario "protegido" sin proteccion, porque pasar sin verificar
# seria desactivar el control en silencio.
# Con las claves puestas, la pagina del formulario recarga la CSP de ESA
# respuesta para permitir el script y el iframe de challenges.cloudflare.com.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Límites del dashboard por usario (F5.3): ventana de 1 hora.
# Crear formularios (POST /forms y duplicar) y exportar datos (estructura/CSV/JSON).
# Protegen a la cuenta ABUSADA (crear de más o barrer el almacén), no al servidor.
DASH_CREATE_PER_HOUR=30
DASH_EXPORT_PER_HOUR=120
# Idioma por defecto de la app (P9, i18n reducido): es | en.
# Un formulario puede sobrescribirlo individualmente en su configuracion (settings.locale.code).
# Registro público. Por defecto APAGADO: en una instalación self-hosted el alta
# de cuentas la hace el admin desde /admin. Enciéndelo solo si quieres que
# cualquiera que llegue a /register pueda crear su propia cuenta.
# Es el valor POR DEFECTO: en cuanto alguien mueva el interruptor de la tarjeta
# «Acceso de cualquiera» en /admin, la fila de `app_settings` gana a este
# fichero (en los dos sentidos). Para volver a mandar este valor, borra la fila:
#   DELETE FROM app_settings WHERE key_name = 'registration_enabled';
REGISTRATION_ENABLED=false
APP_LOCALE=es

# Política de revisión de la INSTANCIA. APAGADA por defecto: cada quien publica
# su formulario sin revisión. Encendida, toda encuesta pasa por la cola de
# revisión antes de publicarse, salvo que su DUEÑO tenga el permiso RBAC
# `forms.publish_without_review` (se concede en /admin/roles).
# Son valores POR DEFECTO: los interruptores «Revisión» de /admin escriben las
# filas `review_required`/`review_notify_email` de `app_settings`, que ganan a
# este fichero en los dos sentidos. Para volver a mandar el `.env`, borra las
# filas:
#   DELETE FROM app_settings WHERE key_name IN ('review_required','review_notify_email');
REVIEW_REQUIRED=false
# Avisar por CORREO a los revisores cuando alguien envía a revisión. Requiere
# MAIL_HOST configurado; sin él el aviso del panel sigue apareciendo igual.
REVIEW_NOTIFY_EMAIL=false

# Zona horaria de PRESENTACION (fase 3): la hora que ve el usuario.
# NO es la zona con la que se guardan las fechas: la BD y PHP trabajan siempre en
# UTC (la sesion hace `SET time_zone = '+00:00'` y bootstrap.php pone PHP en
# UTC), y esta clave solo convierte en el punto de pintar.
# Ponla a la zona donde VIVE quien responde, no la del servidor: una instancia
# en un contenedor en UTC sigue viendo la hora de Caracas con el valor de abajo.
# Ojo: no acepta zonas con horario de verano en el agrupamiento diario (ver
# App\Core\Clock::localSqlOffsetFor); Caracas no aplica DST desde 2016.
APP_TIMEZONE=America/Caracas

# --- Datos de arranque (item 2.3) -------------------------------------------
# database/seed.sql SOLO crea los roles: no lleva usuarios ni hashes. Los
# usuarios demo (admin@demo.com, user@demo.com, editor@demo.com) se siembran
# con `SEED_DEMO=1 php database/seed.php`, y comparten una contraseña pública,
# así que uno es admin con contraseña conocida. Por eso están detrás de un
# opt-in y el default es NO sembrar nada.
SEED_DEMO=false
# Contraseña de esos usuarios demo. Mínimo 10 caracteres (la misma política que
# el registro). Si la dejas vacía se usa `password123`, que es pública: el
# script avisa por stderr. No pongas aquí la contraseña de una cuenta real.
SEED_DEMO_PASSWORD=
# Para una instalación real, crea el primer admin con
#   ADMIN_PASSWORD=una-clave-larga php scripts/create-admin.php
# en vez de sembrar los demo. La contraseña NO se pasa como argumento (queda en
# el historial del shell y en `ps`): va en el entorno, por `--password-stdin` o
# por el prompt sin eco. Estos dos valores no se leen en el arranque normal de
# la app, solo por ese script.
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=

# Uploads de archivos (P10) — límites globales. Un campo de tipo `file` solo
# puede restringirlos (nunca ampliarlos). Requiere que php.ini permita al menos
# esto en upload_max_filesize / post_max_size.
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_FILES=5

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vanilla_forms
DB_USER=mariadb
DB_PASSWORD=m4r14db
DB_CHARSET=utf8mb4

# Sesion
SESSION_NAME=vanillaforms_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Correo (SMTP) — notificaciones al dueño y confirmación al respondiente.
# Con MAIL_HOST vacío el envío se omite (las notificaciones no rompen el
# envío de respuestas y quedan registradas en el log).
MAIL_HOST=               # p. ej. smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls      # '' | tls | ssl
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=       # p. ej. no-reply@tudominio.com
MAIL_FROM_NAME=VanillaForms
MAIL_TIMEOUT=15
