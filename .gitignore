# Variables de entorno (nunca commitear secretos)
.env

# Dependencias
/vendor/

# Cache y logs
/storage/*.log
/storage/cache/

# Adjuntos subidos (P10): se guardan fuera de public/ y nunca se versionan.
/storage/uploads/*
!/storage/uploads/.gitkeep

# Marca de instalación del instalador web (AG11): la crea cada instalación, no
# debe viajar en el repo (si estuviera, nadie podría instalar con `install.php`).
/storage/installed.lock

# Tests temporales
/tests/output/

# Toolkit externo de "levantamiento de información" (genera
# recommendations/coverage). No es código de la app: no entra en el repo.
# Decidido por el autor el 2026-09-28, al hacer el `git init` inicial.
/freddy/
/freddy.zip
/pub.jar
/storage/backups/

# Skills de la herramienta (genéricos de terceros) y material de referencia de
# diseño: no son código de la app y no entran en el repo.
/.opencode/skills/redesign-skill/
/.opencode/skills/ui-ux-pro-max/
/recursos/
