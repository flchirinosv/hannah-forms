                { "value": "Claridad de la información", "group": "rows" },
                { "value": "Precio/valor", "group": "rows" },
                { "value": "Malo", "group": "cols" },
                { "value": "Regular", "group": "cols" },
                { "value": "Bueno", "group": "cols" },
                { "value": "Excelente", "group": "cols" }
