            "label": "¿Nos recomiendas volver a contratar?",
            "is_required": true,
            "parent": 1,
            "options": ["Sí, sin duda", "Probablemente sí", "No estoy seguro", "No"],
            "logic": {
                "operator": "any",
                "rules": [
                    { "field_id": 3, "op": "lte", "value": "3" },
                    { "field_id": 2, "op": "lte", "value": "6" }
